---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../data/site.js';
import { projects } from '../data/projects.js';

const highlights = [
  { when: '2017', what: 'Built my first robot to flip water bottles' },
  { when: '2018', what: 'Assembled a 3D printer to sell fidget spinners in middle school' },
  { when: '2022', what: 'Coded dAIgnose, $1,750 in research grants' },
  { when: '2024', what: 'FIRST Dean’s List Award, top 10 of 80,000+ globally' },
  { when: '2024', what: 'Developed Plant Guardian, received EPA Merit Award' },
  { when: 'Fall 2024', what: 'Started Northeastern abroad in Northern Ireland' },
  { when: 'Spring 2025', what: '3rd place, University Rover Challenge with NURover' },
  { when: 'Fall 2025', what: 'Teaching assistant for FPGA and embedded systems, 90+ students' },
  { when: 'Present', what: 'Vice President of Projects @ Northeastern SEDS' },
  { when: 'Present', what: 'Robotics Engineer Co-op @ Iwa Robotics' },
  { when: 'Present', what: 'CE + CS @ Northeastern University' },
];
---
<Base>
  <div class="container">
    <section class="hero">
      <h1>{site.name}</h1>
      <p class="tagline"><span class="typed" data-words="Robotics Engineer @ Iwa Robotics|CE + CS @ Northeastern">Robotics Engineer @ Iwa Robotics</span></p>
      <img class="avatar" src="/images/headshot.jpg" alt={`Portrait of ${site.name}`} />
    </section>

    <section id="about">
      <div class="about-grid">
        <div>
          <h2 class="section-title">About</h2>
          <p>
            Hi, I'm Shaan Merchant, a computer engineering student at Northeastern University with a strong
            interest in and enthusiasm for robotics, electronics, and applied AI. I enjoy working on projects end to end,
            from drafting geometries in CAD to debugging PCB signals and CAN bugs. Outside of work and school, you'll
            probably find me going on hikes, trying new food spots, or just hanging out with friends. I'm passionate
            about meeting new people and leveraging technology to make a real-world impact, one solution at a time :)
          </p>
          <div class="btn-row">
            <a class="btn" href="/projects">Projects →</a>
            <a class="btn" href="/resume">Resume →</a>
          </div>
        </div>
        <img src="/images/about.jpg" alt="In the lab" />
      </div>
    </section>

    <section id="highlights">
      <h2 class="section-title">Highlights</h2>
      <div class="pcb">
        <span class="silk">SM-TIMELINE · REV {new Date().getFullYear()}</span>
        <div class="pcb-body">
          <ul class="highlights">
            {highlights.map((h, i) => (
              <li class:list={[{ live: h.when === 'Present' }]}>
                <span class="when"><span class="ref">TP{i + 1}</span>{h.when}</span>
                {h.what}
              </li>
            ))}
          </ul>

          <!-- silkscreen line art -->
          <div class="pcb-art" aria-hidden="true">
            <figure>
              <svg viewBox="0 0 100 100">
                <path d="M43 43 26 26M57 43 74 26M43 57 26 74M57 57 74 74" />
                <rect x="38" y="38" width="24" height="24" rx="5" />
                <circle cx="50" cy="50" r="4" />
                <g stroke-dasharray="5 4"><circle cx="21" cy="21" r="15" /><circle cx="79" cy="21" r="15" /><circle cx="21" cy="79" r="15" /><circle cx="79" cy="79" r="15" /></g>
                <path d="M12 16l18 10M70 26l18-10M12 84l18-10M70 74l18 10" />
                <circle cx="21" cy="21" r="2.5" /><circle cx="79" cy="21" r="2.5" /><circle cx="21" cy="79" r="2.5" /><circle cx="79" cy="79" r="2.5" />
              </svg>
              <figcaption>ART1 DRONE</figcaption>
            </figure>
            <figure>
              <svg viewBox="0 0 120 80">
                <rect x="28" y="28" width="58" height="15" rx="2" />
                <path d="M76 28V12M70 5h14v8H70zM38 28V20M33 20h10" />
                <path d="M40 43 22 62M40 43 52 55 58 62M80 43 94 62M66 50 58 62" />
                <circle cx="22" cy="66" r="9" /><circle cx="58" cy="66" r="9" /><circle cx="94" cy="66" r="9" />
              </svg>
              <figcaption>ART2 ROVER</figcaption>
            </figure>
            <figure>
              <svg viewBox="0 0 110 90">
                <rect x="10" y="74" width="34" height="9" rx="2" />
                <path d="M27 74v-6" />
                <circle cx="27" cy="63" r="5" />
                <path d="M30 59 46 34" />
                <circle cx="49" cy="30" r="5" />
                <path d="M54 29 80 22" />
                <circle cx="84" cy="21" r="4" />
                <path d="M87 18l9-7 4 4M87 24l9 7 4-4" />
              </svg>
              <figcaption>ART3 ARM</figcaption>
            </figure>
            <figure>
              <svg viewBox="0 0 110 80">
                <path d="M5 72 38 24l15 21 17-27 35 54Z" />
                <path d="M30 36l5 3 3-4 4 5 4-4M62 30l5 3 3-3 4 4" />
                <circle cx="88" cy="16" r="6" />
                <path d="M20 72c10-8 22-6 30-14s18-6 24-12" stroke-dasharray="3 4" />
              </svg>
              <figcaption>ART4 TRAILS</figcaption>
            </figure>
          </div>
        </div>

        <div class="pcb-foot">
          <div class="j1">
            <span class="j1-label">J1 · CONTACT</span>
            <div class="j1-body">
              <a class="pin pin1" href={`mailto:${site.email}`} aria-label="Email me"><i></i><span>EMAIL</span></a>
              <a class="pin" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><i></i><span>LINKEDIN</span></a>
              <a class="pin" href={site.resume} target="_blank" rel="noopener" aria-label="Resume"><i></i><span>RESUME</span></a>
              <span class="pin gnd" title="Ground. Every good board needs one."><i></i><span>GND</span></span>
            </div>
          </div>
          <span class="silk silk-end">DESIGNED BY S. MERCHANT</span>
        </div>
      </div>
    </section>

    <section id="projects">
      <h2 class="section-title">Projects</h2>
      <div class="grid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    <section id="contact">
      <h2 class="section-title">Let's Connect</h2>
      <ContactLinks />
    </section>
  </div>

  <script>
    const el = document.querySelector('.typed');
    if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const words = el.dataset.words.split('|');
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      (async () => {
        for (let w = 0; ; w = (w + 1) % words.length) {
          const word = words[w];
          for (let i = 0; i <= word.length; i++) {
            el.textContent = word.slice(0, i);
            await sleep(70);
          }
          await sleep(2000);
          for (let i = word.length; i >= 0; i--) {
            el.textContent = word.slice(0, i);
            await sleep(35);
          }
          await sleep(300);
        }
      })();
    }
  </script>
</Base>
