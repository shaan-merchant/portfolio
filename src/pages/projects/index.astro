---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects.js';
---
<Base title="Projects">
  <div class="container">
    <section>
      <h1 class="section-title">Projects</h1>
      <div class="grid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  </div>
</Base>
