---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<Base title={project.title} description={project.summary}>
  <div class="container">
    <header class="project-head">
      <a class="back" href="/projects">← All projects</a>
      <h1>{project.title}</h1>
      <div class="meta">
        <span>{project.org}</span>
        <span>{project.timeline}</span>
      </div>
      {project.tags && <div class="tags">{project.tags.map((t) => <span class="tag">{t}</span>)}</div>}
    </header>

    <article class="writeup">
      {project.sections.map((s) => (
        <>
          <h2>{s.label}</h2>
          <p>{s.text}</p>
        </>
      ))}
      {project.links && (
        <div class="btn-row">
          {project.links.map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        </div>
      )}
    </article>

    <div class="media">
      {project.media.map((m) => (
        <figure>
          {m.type === 'image' && <img src={m.src} alt={m.caption} loading="lazy" />}
          {m.type === 'video' && <video src={m.src} poster={m.poster} controls muted playsinline preload="none" />}
          {m.type === 'embed' && <iframe src={m.src} title={m.caption} loading="lazy" allowfullscreen />}
          {m.caption && <figcaption>{m.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</Base>
