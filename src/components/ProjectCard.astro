---
const { project } = Astro.props;
---
<a class="card" href={`/projects/${project.slug}`}>
  <div class="thumb"><img src={project.card} alt={project.title} loading="lazy" /></div>
  <span class="org">{project.org}</span>
  <h3>{project.title}</h3>
  <p>{project.summary}</p>
  <span class="more">Read more →</span>
</a>
